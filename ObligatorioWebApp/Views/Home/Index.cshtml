@using LogicaAplicacion.DTOs
@model IEnumerable<LogicaAplicacion.DTOs.UsuarioDTO>

<div class="text-center">
    <h1 class="display-4">Welcome @Context.Session.GetString("usuario")</h1>
</div>

@* ESTA TABLA LA USAREMOS MÁS ADELANTE :D
<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Clave</th>
            <th>Email</th>
            <th>Rol de Usuario</th>
            <th>Equipo</th>
        </tr>
    </thead>
    <tbody>
        @foreach (UsuarioDTO usuario in Model)
        {
            <tr>
                <td>@usuario.Id</td>
                <td>@usuario.Nombre</td>
                <td>@usuario.Apellido</td>
                <td>@usuario.Clave</td>
                <td>@usuario.Email</td>
                <td>@usuario.RolDeUsuario.TipoRol</td>
                <td>@usuario.Equipo?.Id</td>
            </tr>
        }
    </tbody>
</table>
*@

