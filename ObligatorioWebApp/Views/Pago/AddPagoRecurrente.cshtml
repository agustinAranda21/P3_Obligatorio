@using LogicaAplicacion.DTOs
@model ObligatorioWebApp.ViewModels.AddPagoViewModel

<form method="post">
    <div class="form-group">
        <h1>Registrar nuevo pago recurrente</h1>
        <label for="MetodoDePago">Metodo de pago</label>
        <select  asp-for="MetodoDePago" class="form-control" required>
            <option value="" disabled selected>Seleccione...</option>
            <option value=1>Credito</option>
            <option value=2>Efectivo</option>
        </select>
        <label for="TipoGastoId">Tipo de gasto</label>
        <select asp-for="TipoGastoId" class="form-control" required>
            <option value="" disabled selected>Seleccione...</option>
            @foreach (TipoGastoDTO tipo in Model.TiposGasto)
            {
                <option value="@tipo.Id">@tipo.Nombre</option>
            }
        </select>
    </div>
    <div class="form-group">
        <label for="UsuarioId">Usuario</label>
        <select asp-for="UsuarioId" class="form-control" required>
            <option value="" disabled selected>Seleccione...</option>
            @foreach (UsuarioDTO usuario in Model.Usuarios)
            {
                <option value="@usuario.Id">@usuario.Nombre @usuario.Apellido</option>
            }
        </select>
    </div>
    <div class="form-group">
        <label for="Descripcion">Descripcion</label>
        <input type="text" class="form-control" asp-for="Descripcion" placeholder="Descripcion" required>
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label for="Monto">Monto</label>
        <input type="number" step="0.01" class="form-control" asp-for="Monto" placeholder="Monto" required>
        <span asp-validation-for="Monto" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label for="Desde">Desde</label>
        <input type="date" class="form-control" asp-for="Desde" placeholder="Desde" required />
    </div>
    <div class="form-group">
        <label for="Hasta">Hasta</label>
        <input type="date" class="form-control" asp-for="Hasta" placeholder="Hasta" required />
    </div>
    <button type="submit" class="btn btn-primary rounded-pill shadow-sm">Añadir</button>
</form>

@if(ViewBag.Mensaje != null)
{
    <div class="alert alert-success">
        @ViewBag.Mensaje
    </div>
}

@if(ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @Html.Raw(ViewBag.Error)
    </div>
}