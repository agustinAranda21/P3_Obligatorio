@using LogicaAplicacion.DTOs
@model ObligatorioWebApp.ViewModels.AddPagoViewModel

<form method="post">
    <div class="form-group">
        <h1>Registrar nuevo pago unico</h1>
        <label for="idMetodoDePago">Metodo de pago</label>
        <select name="MetodoDePago" id="idMetodoDePago" class="form-control">
            <option value=1>Credito</option>
            <option value=2>Efectivo</option>
        </select>
        <label for="idTipoGasto">Tipo de gasto</label>
        <select name="TipoGasto" id="idTipoGasto" class="form-control">
            <option disabled selected>Seleccione...</option>
            @foreach (TipoGastoDTO tipo in Model.TiposGasto)
            {
                <option value="@tipo.Id">@tipo.Nombre</option>
            }   
            </select>
    </div>
    <div class="form-group">
        <label for="idUsuario">Usuario</label>
        <select name="Usuario" id="idUsuario" class="form-control">  
            <option disabled selected>Seleccione...</option>
            @foreach (UsuarioDTO usuario in Model.Usuarios)
            {
                <option value="@usuario.Id">@usuario.Nombre @usuario.Apellido</option>
            }
        </select>
    </div>
    <div class="form-group">
        <label for="descripcion">Descripcion</label>
        <input type="text" class="form-control" name="Descripcion" id="descripcion" placeholder="Descripcion">
    </div>
    <div class="form-group">
        <label for="monto">Monto</label>
        <input type="number" class="form-control" name="Monto" id="monto" placeholder="Monto">
    </div>
    <div class="form-group">
        <label for="fechaPago">Fecha de pago</label>
        <input type="date" class="form-control" name="FechaDePago" id="fechaPago" placeholder="Fecha de pago"/>
    </div>
    <div class="form-group">
        <label for="numeroRecibo">Número de recibo</label>
        <input type="text" class="form-control" name="NumeroDeRecibo" id="numeroRecibo" placeholder="Número de recibo" />
    </div>
    <button type="submit" class="btn btn-primary">Añadir</button>
</form>
