@using LogicaAplicacion.DTOs

    <h2>Selecciona el tipo de pago que quiera registrar...</h2>
    <p>
        <a asp-controller="Pago" asp-action="AddPagoUnico">Unico</a> -
        <a asp-controller="Pago" asp-action="AddPagoRecurrente">Recurrente</a> 
    </p>


    @if(Context.Session.GetString("usuarioRol") == "Gerente")
    {
        <h2>Lista de pagos</h2>
        <p>
            <a asp-controller="Pago" asp-action="ListadoMensual">Ver listado</a>
        </p>
    }



