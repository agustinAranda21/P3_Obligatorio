@model ObligatorioWebApp.ViewModels.AddTipoGastoViewModel
<form method="post">
    <div class="form-group">
        <h1>Agregar nuevo tipo de gasto</h1>
        <label for="Nombre">Nombre</label>
        <input type="text" class="form-control" asp-for="Nombre" placeholder="Ingrese un nombre" required>
    </div>
    <div class="form-group">
        <label for="Descripcion">Descripcion</label>
        <input type="text" class="form-control" asp-for="Descripcion" placeholder="Ingrese una descripción">
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>
    <br>
    <button type="submit" class="btn btn-primary rounded-pill shadow-sm"><i class="bi bi-plus-square-fill"> Crear</i></button>
</form>

@if(ViewBag.Mensaje != null)
{
    <div class="alert alert-success">
        <i class="bi bi-check-circle-fill"> @Html.Raw(ViewBag.Mensaje)</i>
    </div>
}

@if(ViewBag.Error != null)
{
    <div class="alert alert-danger">
        <i class="bi bi-x-circle-fill"> @Html.Raw(ViewBag.Error)</i>
    </div>
}