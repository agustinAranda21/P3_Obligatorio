@model ObligatorioWebApp.ViewModels.AddTipoGastoViewModel
<form method="post">
    <div class="form-group">
        <h1>Agregar nuevo tipo de gasto</h1>
        <label for="Nombre">Nombre</label>
        <input type="text" class="form-control" asp-for="Nombre" placeholder="Nombre" required>
    </div>
    <div class="form-group">
        <label for="Descripcion">Descripcion</label>
        <input type="text" class="form-control" asp-for="Descripcion" placeholder="Descripcion">
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary rounded-pill shadow-sm">Crear</button>
</form>

@if(ViewBag.Mensaje != null)
{
    <div class="alert alert-success">
        @ViewBag.Mensaje
    </div>
}

@if(ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}