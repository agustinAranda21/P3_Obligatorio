@using LogicaAplicacion.DTOs

@model IEnumerable<LogicaAplicacion.DTOs.TipoGastoDTO>
        <h1>Editar tipo de gasto</h1>
<table class="table table-striped table-bordered table-hover table-responsive">
            <thead class="table-dark">
                <tr>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Accion</th>
                </tr>
            </thead>
            <tbody>
                @foreach (TipoGastoDTO tipoGasto in Model)
                {
                    <form method="post">
                    <div class="form-group">
                    <tr>
                            <input type="hidden" name="Id" value="@tipoGasto.Id"/>
                        <td>
                            <input type="text" name="Nombre" value="@tipoGasto.Nombre" class="form-control" />
                        </td>
                        <td>
                            <input type="text" name="Descripcion" value="@tipoGasto.Descripcion" class="form-control" />
                        </td>
                        <td>
                    <button type="submit" class="btn btn-primary rounded-pill shadow-sm"><i class="bi bi-pencil-fill"> Actualizar</i></button>
                        </td>
                    </tr>
                   </div>
                   </form>
                }
            </tbody>
        </table>
   
 @if(ViewBag.Message != null)
{
    <div class="alert alert-success">
        <i class="bi bi-check-circle-fill"> @Html.Raw(ViewBag.Message)</i>
    </div>
}

@if(ViewBag.Error != null)
{
    <div class="alert alert-danger">
        <i class="bi bi-x-circle-fill"> @Html.Raw(ViewBag.Error)</i>
    </div>
}




