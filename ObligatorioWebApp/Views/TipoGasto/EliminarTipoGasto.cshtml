@using LogicaAplicacion.DTOs
@model IEnumerable<LogicaAplicacion.DTOs.TipoGastoDTO>

<h1>Eliminar tipo de gasto</h1>
<table class="table table-striped table-bordered table-hover table-responsive">
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Accion</th>
        </tr>
    </thead>
    <tbody>
        @foreach (TipoGastoDTO tipoGasto in Model)
        {
            <tr>
                <form method="post">
                    <td>
                        <input type="hidden" name="Id" value="@tipoGasto.Id" />
                        @tipoGasto.Id
                    </td>
                    <td>
                        <input type="hidden" name="Nombre" value="@tipoGasto.Nombre" />
                        @tipoGasto.Nombre
                    </td>
                    <td>
                        <input type="hidden" name="Descripcion" value="@tipoGasto.Descripcion" />
                        @tipoGasto.Descripcion
                    </td>
                    <td>
                    <button type="submit" class="btn btn-danger rounded-pill shadow-sm"><i class="bi bi-trash-fill"> Eliminar</i></button>
                    </td>
                </form>
            </tr>
        }
    </tbody>
</table>

@if(ViewBag.Mensaje != null)
{
    <div class="alert alert-success">
        <i class="bi bi-check-circle-fill"> @Html.Raw(ViewBag.Mensaje)</i>
    </div>
}

@if(ViewBag.Error != null)
{
     <div class="alert alert-danger">
        <i class="bi bi-x-circle-fill"> @Html.Raw(ViewBag.Error)</i>
        </div>
}