@using LogicaAplicacion.DTOs
@model IEnumerable<LogicaAplicacion.DTOs.TipoGastoDTO>


<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Accion</th>
        </tr>
    </thead>
    <tbody>
        @foreach (TipoGastoDTO tipoGasto in Model)
        {
            <tr>
                <form method="post">
                    <td>
                        <input type="hidden" name="Id" value="@tipoGasto.Id" />
                        @tipoGasto.Id
                    </td>
                    <td>
                        <input type="hidden" name="Nombre" value="@tipoGasto.Nombre" />
                        @tipoGasto.Nombre
                    </td>
                    <td>
                        <input type="hidden" name="Descripcion" value="@tipoGasto.Descripcion" />
                        @tipoGasto.Descripcion
                    </td>
                    <td>
                    <button type="submit" class="btn btn-danger rounded-pill shadow-sm">Eliminar</button>
                    </td>
                </form>
            </tr>
        }
    </tbody>
</table>

@if(ViewBag.Mensaje != null)
{
    <div class="alert alert-success">
        @ViewBag.Mensaje
    </div>
}

@if(ViewBag.Error != null)
{
     <div class="alert alert-danger">
            @ViewBag.Error
        </div>
}