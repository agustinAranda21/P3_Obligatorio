@using LogicaAplicacion.DTOs
@model List<UsuarioDTO>

    @if(!string.IsNullOrEmpty(Context.Session.GetString("usuarioRol")) && Context.Session.GetString("usuarioRol").Equals("Gerente") )
    {
<form method="post">
    <div class="form-group">
        <label for="IdMonto">Monto: </label>
        <input type="number" class="form-control" name="unMonto" id="IdMonto" placeholder="Monto" required>
    </div>
    <br>
        <button type="submit" class="btn btn-primary rounded-pill shadow-sm"><i class="bi bi-card-list"> Listar</i></button>
</form>

    <table class="table table-striped table-bordered table-hover table-responsive">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Email</th>
                <th>Rol</th>
                <th>Equipo</th>
            </tr>
        </thead>
        <tbody>
        @foreach (UsuarioDTO usuario in Model)
            {
                <tr>
                    <td>@usuario.Id</td>
                    <td>@usuario.Nombre</td>
                    <td>@usuario.Apellido</td>
                    <td>@usuario.Email</td>
                    <td>@usuario.RolDeUsuario.TipoRol</td>
                    <td>@usuario.Equipo.Nombre</td>
                </tr>
            }
    </tbody>
</table>

@if (ViewBag.Message != null)
{
    <div class="alert alert-info" role="alert">
            <i class="bi bi-exclamation-circle-fill"> @Html.Raw(ViewBag.Error)</i>
    </div>
}

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger" role="alert">
            <i class="bi bi-x-circle-fill"> @Html.Raw(ViewBag.Error)</i>
    </div>
    }
} else
{
    <div class="alert alert-danger" role="alert">
        <p><i class="bi bi-check-circle-fill"> No tienes permisos para acceder a esta funcionalidad.</i></p>
    </div>
}

