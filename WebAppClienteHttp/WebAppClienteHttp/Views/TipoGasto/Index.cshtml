@using WebAppClienteHttp.DTOs
@model List<WebAppClienteHttp.DTOs.AuditoriaTipoGastoDTO>

    <h2>Listado de auditorías</h2>
    <table class="table table-striped table-bordered table-hover table-responsive">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Descripción</th>
                <th>Acción</th>
                <th>Fecha</th>
                <th>Usuario</th>
            </tr>
        </thead>
        <tbody>
            @foreach (AuditoriaTipoGastoDTO a in Model)
            {
                <tr>
                    <td>@a.Id</td>
                    <td>@a.Nombre</td>
                    <td>@a.Descripcion</td>
                    <td>@a.Accion</td>
                    <td>@a.Fecha</td>
                    <td>@a.Usuario</td>
                </tr>
            }
        </tbody>
    </table>


