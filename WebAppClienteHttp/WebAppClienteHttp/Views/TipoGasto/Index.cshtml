@using WebAppClienteHttp.DTOs
@model IEnumerable<WebAppClienteHttp.DTOs.AuditoriaTipoGastoDTO>

    <form method="post">
        <div class="form-group">
        <input type="number" name="idTipoGasto" id="idTipoGasto" class="form-control mb-3" />
        <button type="submit" class="btn btn-primary rounded-pill shadow-sm mb-3"><i class="bi bi-card-list">Listar</i></button>
        </div>
    </form>

    <h2>Listado de auditorías</h2>
    <table class="table table-striped table-bordered table-hover table-responsive">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Descripción</th>
                <th>Acción</th>
                <th>Fecha</th>
                <th>IdTipoGasto</th>
            </tr>
        </thead>
        <tbody>
            @foreach (AuditoriaTipoGastoDTO a in Model)
            {
                <tr>
                    <td>@a.Id</td>
                    <td>@a.Nombre</td>
                    <td>@a.Descripcion</td>
                    <td>@a.Accion</td>
                    <td>@a.Fecha</td>
                    <td>@a.IdTipoGasto</td>
                </tr>
            }
        </tbody>
    </table>


