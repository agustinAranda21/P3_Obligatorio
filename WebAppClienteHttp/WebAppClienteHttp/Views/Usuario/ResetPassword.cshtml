@{
    ViewBag.Title = "Resetear Contraseña";
}

<h2>Resetear contraseña de usuario</h2>

<form method="post" asp-action="ResetPasswordPost">
    <label>ID de Usuario:</label>
    <input type="number" name="idUsuario" class="form-control" required />
    <br />
    <button class="btn btn-danger">Resetear contraseña</button>
</form>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger mt-3">@ViewBag.Error</div>
}

@if (ViewBag.NuevaPassword != null)
{
    <div class="alert alert-success mt-3">
        Nueva contraseña generada: <strong>@ViewBag.NuevaPassword</strong>
    </div>
}
